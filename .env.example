# Copy this file to .env.local and fill in what you need.
# Everything is optional for a local demo: without Supabase the app uses a
# local JSON store in .data/ and seeds it with clearly marked sample reports.

# Public URL of the site (used for share links and Open Graph images).
# On Vercel this falls back to the production URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Postgres). Use the service role key: it is only ever read on the
# server (API routes and server components), never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin page (/admin). Required in production. In local development the
# password defaults to "hosh-demo" if this is empty.
ADMIN_PASSWORD=

# Secret used to sign admin sessions, edit tokens and flag fingerprints.
# Any long random string. Required in production.
HOSH_SECRET=

# Optional: an email address for takedown requests, shown on /about.
# If empty, the About page points people to Instagram @hoshkaro instead.
NEXT_PUBLIC_TAKEDOWN_EMAIL=
